# Copy to .env and replace the placeholders locally. Never commit .env.
DATABASE_URL=postgresql+psycopg2://lifelog_user:replace_password@localhost:5432/lifelog_db
OPENAI_API_KEY=replace_with_your_existing_provider_key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
RAG_MIN_COSINE_SIMILARITY=0.30
